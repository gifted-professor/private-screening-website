{
  "name": "private-screening-website",
  "version": "1.0.0",
  "private": true,
  "description": "只映给你 PRIVATE SCREENING 官网",
  "scripts": {
    "fonts": "bash scripts/fetch_fonts.sh",
    "build": "python3 scripts/build.py",
    "build:cn": "python3 scripts/build.py --local-vendor",
    "serve": "python3 -m http.server 8000 --directory site",
    "check": "python3 scripts/check.py"
  },
  "devDependencies": {
    "@fontsource/cormorant-garamond": "5.3.0",
    "gsap": "3.15.0",
    "lenis": "1.3.26"
  }
}
